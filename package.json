{
  "name": "earth-analog-discovery-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "check:web": "tsc --noEmit -p tsconfig.web.json",
    "dev": "npm run build && npm run check:web && node scripts/app-dev.mjs",
    "api": "node scripts/app-api.mjs",
    "start": "node scripts/app-api.mjs",
    "build:app": "npm run build && npm run check:web && npm run build:web",
    "test": "npm run build && node --test dist/tests/*.test.js tests/app-api.test.mjs tests/persistent-data.test.mjs tests/reference-curation.test.mjs",
    "audit:atlas": "npm run build && node dist/scripts/audit-atlas.js",
    "retrieve:nasa-power": "npm run build && node dist/scripts/retrieve-nasa-power.js",
    "rebuild:nasa-power": "npm run build && node dist/scripts/rebuild-nasa-power.js",
    "extract:copernicus-dem": "npm run build && node dist/scripts/retrieve-copernicus-dem.js",
    "ingest:copernicus-dem": "npm run build && node dist/scripts/ingest-copernicus-dem.js",
    "retrieve:copernicus-dem": "npm run extract:copernicus-dem && npm run ingest:copernicus-dem",
    "validate:copernicus-dem": "npm run ingest:copernicus-dem",
    "retrieve:glim": "npm run build && node dist/scripts/retrieve-glim.js",
    "rebuild:glim": "npm run build && node dist/scripts/rebuild-glim.js",
    "validate:glim": "npm run rebuild:glim",
    "validate:mission-profiles": "npm run build && node dist/scripts/validate-mission-profiles.js",
    "build:reference-sites": "npm run build && node dist/scripts/build-reference-dataset.js",
    "validate:reference-sites": "npm run build && node dist/scripts/validate-reference-sites.js",
    "retrieve:supplementary-evidence": "npm run build && node dist/scripts/retrieve-supplementary-evidence.js",
    "discover:candidates": "npm run build && node dist/scripts/run-discovery.js",
    "validate:discovery": "npm run build && node dist/scripts/validate-discovery.js",
    "compare:candidates": "npm run build && node dist/scripts/run-comparison.js",
    "validate:comparison": "npm run build && node dist/scripts/validate-comparison.js",
    "build:evidence": "npm run build && node dist/scripts/normalize-m2-acquired-evidence.js && node scripts/build-m2-m3-evidence.mjs",
    "validate:evidence": "npm run build && node dist/scripts/validate-evidence.js",
    "build:prototype": "npm run audit:atlas",
    "validate:data": "npm run build && node dist/scripts/validate-data.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "d3-geo": "^3.1.2",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  }
}
